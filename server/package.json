{
  "name": "nyssvaaja-neo-server",
  "version": "0.0.1",
  "description": "Server module for Nyssvääjä",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"tsc -w\" \"nodemon --watch dist dist/index.js\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "https://github.com/lehtoroni/",
  "license": "MIT",
  "dependencies": {
    "args-parser": "^1.3.0",
    "body-parser": "^2.3.0",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.0",
    "fast-xml-parser": "^5.2.5",
    "gtfs-realtime-bindings": "^2.0.0",
    "helmet": "^7.1.0",
    "md5": "^2.3.0",
    "mqtt": "^5.15.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "protobufjs": "^8.6.5",
    "session-file-store": "^1.5.0",
    "toml": "^3.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "~1.19.6",
    "@types/express": "~4.17.21",
    "@types/express-session": "~1.18.0",
    "@types/md5": "~2.3.6",
    "@types/session-file-store": "~1.2.5",
    "@yao-pkg/pkg": "^6.19.0",
    "concurrently": "^9.2.0",
    "nodemon": "^3.1.10",
    "typescript": "^5.4.5",
    "typesync": "^0.12.1"
  },
  "pkg": {
    "compress": "GZip",
    "signature": false,
    "assets": [
      "front-dist/**/*"
    ],
    "targets": [
      "node22-linux-x64",
      "node22-win-x64"
    ],
    "outputPath": "build"
  }
}
