{
    "compilerOptions": {
        "declaration": true,
        "module": "Node16",
        "moduleResolution": "Node16",
        "removeComments": true,
        "strict": true,
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "sourceMap": true,
        "outDir": "dist",
        "target": "es2024",
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@app/*": ["src/*"]
        }
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "./node_modules",
        "./node_modules/*"
    ]
}